MINIMAX_API_KEY=replace-with-your-key
MINIMAX_API_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7
# bigmodel: keep Claude Agent SDK, use BigModel's official Anthropic endpoint.
BIGMODEL_API_KEY=replace-with-your-key
BIGMODEL_MODEL=glm-5.3
BIGMODEL_VISION_MODEL=glm-4.6v
# auto: use Claude Agent SDK with the configured Anthropic or MiniMax provider.
# claude: require Anthropic; compatible: internal single-shot helpers only, not the Career Agent.
# minimax: run Claude Agent SDK with MINIMAX_API_KEY / MINIMAX_API_URL / MINIMAX_MODEL.
RESUME_PROTOCOL_AGENT_RUNTIME=auto
# Optional typed JEV field-purpose decisions use TYPESAFE_API_KEY or Windows
# Credential Manager. Never send a key in chat or commit an actual key here.
# TYPESAFE_API_KEY=replace-with-a-rotated-key
# Optional semantic retrieval: explicitly configured, already-installed local
# Ollama embedding model. No automatic installation/pull or chat-key reuse.
# Get the exact model name and full 64-hex digest from GET /api/tags.
# RESUME_EMBEDDING_BASE_URL=http://127.0.0.1:11434
# RESUME_EMBEDDING_MODEL=your-installed-embedding-model:tag
# RESUME_EMBEDDING_DIGEST=full-64-hex-model-digest
# Alternative explicitly chosen cloud embedding (separate from chat/JEV keys).
# Save in ignored .env.embedding; npm run server/app load this dedicated file.
# RESUME_EMBEDDING_PROVIDER=qianwen
# RESUME_EMBEDDING_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
# RESUME_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# RESUME_EMBEDDING_DIMENSIONS=1024
# RESUME_EMBEDDING_REVISION=2026-10-09
# RESUME_EMBEDDING_API_KEY=replace-with-your-key
# Alternative Google Generative Language embedding (gemini-embedding-001).
# Dimensions accept 768/1536/3072 (MRL); queries use RETRIEVAL_QUERY task type.
# Networks without direct Google access: the embedding transport automatically
# routes through HTTPS_PROXY/HTTP_PROXY when set (chat traffic is unaffected).
# RESUME_EMBEDDING_PROVIDER=google
# RESUME_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# RESUME_EMBEDDING_MODEL=gemini-embedding-001
# RESUME_EMBEDDING_DIMENSIONS=3072
# RESUME_EMBEDDING_REVISION=2026-10-10
# RESUME_EMBEDDING_API_KEY=replace-with-your-key
# Cloud model aliases are not immutable digests. Bump REVISION to invalidate
# derived caches after an announced model update; no immutable-version claim.
# ANTHROPIC_API_KEY=your-anthropic-api-key
# CLAUDE_AGENT_MODEL=sonnet
# Windows: set this if Git Bash cannot be found automatically.
# CLAUDE_CODE_GIT_BASH_PATH=C:/Program Files/Git/bin/bash.exe
RESUME_PROTOCOL_PORT=8787
RESUME_PROTOCOL_HOST=127.0.0.1
# Optional: absolute directory for SQLite and private uploads (default: ./data)
# RESUME_PROTOCOL_DATA_DIR=D:/Resume Protocol/data
# Password reset codes are emailed over SMTP. QQ/163 mail: enable SMTP in the
# mailbox settings and use the generated authorization code, not your login password.
# RESUME_PROTOCOL_SMTP_HOST=smtp.qq.com
# RESUME_PROTOCOL_SMTP_PORT=465
# RESUME_PROTOCOL_SMTP_USER=your-address@qq.com
# RESUME_PROTOCOL_SMTP_PASS=your-smtp-authorization-code
# RESUME_PROTOCOL_SMTP_FROM=Loomi <your-address@qq.com>
# When deploying behind HTTPS, set the public origin and secure cookies:
# RESUME_PROTOCOL_ORIGIN=https://your-domain.example
# RESUME_PROTOCOL_SECURE_COOKIES=true
# 可选：导出PDF/DOCX与原PDF批注使用Python。本机自动使用已安装的Codex文档运行环境。
# RESUME_PROTOCOL_PYTHON=C:/path/to/python.exe
# Optional pinned Hiring Radar checkout (default: data/integrations/hiring-radar).
# Run npm run jobs:setup-hiring-radar before collection.
# RESUME_PROTOCOL_HIRING_RADAR_DIR=D:/path/to/hiring-radar
# RESUME_PROTOCOL_FONT=C:/Windows/Fonts/msyh.ttc

# Optional dedicated vision model for scanned PDFs (uses existing user model otherwise).
# Windows also supports local Windows OCR without sending page images externally.
# RESUME_VISION_PROTOCOL=openai
# RESUME_VISION_BASE_URL=https://your-provider.example/v1
# RESUME_VISION_MODEL=your-vision-capable-model
# RESUME_VISION_API_KEY=your-vision-api-key
